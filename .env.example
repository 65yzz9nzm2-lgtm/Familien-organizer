# FamilyHub – Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real secrets.

# --- Supabase ---
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google OAuth (configured in Supabase, not used directly by the frontend) ---
# See README.md "Google OAuth einrichten" for the full step-by-step guide.
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are entered in the Supabase Dashboard
# under Authentication -> Providers -> Google, NOT in this file.

# --- Optional: Family Assistant (AI) ---
# Leave unset to run the assistant in mock mode (no external API calls).
# VITE_AI_PROVIDER=anthropic
# AI API keys must never be exposed with a VITE_ prefix — they belong in a
# server-side Supabase Edge Function secret, not in the frontend bundle.

# --- App ---
VITE_APP_NAME=FamilyHub
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_LOCALE=de-DE
